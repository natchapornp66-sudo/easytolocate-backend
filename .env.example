NODE_ENV=production
PORT=5000
# Use 127.0.0.1 when a reverse proxy runs on the same machine; containers may need 0.0.0.0.
HOST=127.0.0.1
# Use a new PostgreSQL database for production. Never include this URL in frontend settings.
DATABASE_URL=postgresql://app_user:CHANGE_ME@database-host:5432/easytolocate
# Generate a unique random secret (at least 32 characters); never reuse the example.
JWT_SECRET=REPLACE_ME_WITH_A_UNIQUE_RANDOM_SECRET
# Exact HTTPS origin(s), comma-separated if needed. No paths or wildcard.
FRONTEND_URL=https://your-domain.example
# Absolute directory on a persistent disk/volume, separate from release files.
UPLOAD_DIR=/var/lib/easytolocate/uploads
SERVE_FRONTEND=true
# Optional cloud storage for Render Free. Keep the service role key BACKEND ONLY.
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=BACKEND_ONLY_SERVICE_ROLE_KEY
# SUPABASE_STORAGE_BUCKET=easytolocate-files
# In cloud mode UPLOAD_DIR is temporary staging; permanent files live in the private bucket.
# Optional: defaults to backend/public-app created by npm run prepare:release.
# FRONTEND_DIST_DIR=/srv/easytolocate/public-app
# Set 1 only when the app is reachable exclusively through one trusted reverse proxy.
TRUST_PROXY=0
# Optional TLS with certificate verification. DATABASE_URL may also carry provider sslmode.
# DB_SSL=true
# DB_SSL_CA_FILE=/run/secrets/database-ca.pem
# Optional directory containing PostgreSQL 18 pg_dump/pg_restore, for backup/export.
# PG_BIN_DIR=/usr/lib/postgresql/18/bin
